# ── Backend ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///iot_maintenance.db   # or postgresql://user:pass@host/db
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000

# Anomaly thresholds (server-side guard rails)
ANOMALY_TEMP_MIN=20.0
ANOMALY_TEMP_MAX=80.0
ANOMALY_VIBRATION_MAX=5.0
ANOMALY_CURRENT_MAX=15.0

# ── Edge Nodes ────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:5000

# Physical Node (Node 1)
NODE_ID=node_physical
FL_LISTEN_PORT=5001
PEER_FL_URL=http://localhost:5002
FL_EXCHANGE_INTERVAL=60    # seconds between FL weight exchanges
SEND_INTERVAL=2.0          # seconds between sensor readings

# Simulated Node (Node 2)
# NODE_ID=node_simulated
# FL_LISTEN_PORT=5002
# PEER_FL_URL=http://localhost:5001
# SIM_BASE_TEMP=38.0
# SIM_BASE_VIB=0.9
# SIM_BASE_CUR=5.8

# ── Frontend ──────────────────────────────────────────────────────────────────
REACT_APP_BACKEND_URL=http://localhost:5000
